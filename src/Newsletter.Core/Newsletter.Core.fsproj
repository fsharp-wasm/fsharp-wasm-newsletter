<Project Sdk="Microsoft.NET.Sdk">
  <!-- The newsletter library: document model, framework profiles, the three renderers, JSON, checks and the designer's state
       machine.  Pure F# on the subset fsharp-wasm compiles, so the same source runs under .NET (the tests) and as WasmGC (the designer). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <RootNamespace>Newsletter</RootNamespace>
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);NU1900;NETSDK1188</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Json.fs" />
    <Compile Include="Model.fs" />
    <Compile Include="Color.fs" />
    <Compile Include="Profile.fs" />
    <Compile Include="Markup.fs" />
    <Compile Include="Render.fs" />
    <Compile Include="Codec.fs" />
    <Compile Include="Lint.fs" />
    <Compile Include="Sample.fs" />
    <Compile Include="Studio.fs" />
  </ItemGroup>
</Project>
