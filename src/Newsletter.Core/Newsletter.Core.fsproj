<Project Sdk="Microsoft.NET.Sdk">
  <!-- The newsletter library: document model, framework profiles, the three renderers, checks and the designer's state
       machine (JSON and the typed CSS/HTML come from fsharp-wasm-core: FSharp.Wasm.Data, FSharp.Wasm.Ui).  Pure F# on the subset fsharp-wasm compiles, so the same source runs under .NET (the tests) and as WasmGC (the designer). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <RootNamespace>Newsletter</RootNamespace>
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);NU1900;NETSDK1188</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../lib/fsharp-wasm-core/FSharp.Wasm.Data/FSharp.Wasm.Data.fsproj" />
    <ProjectReference Include="../../lib/fsharp-wasm-core/FSharp.Wasm.Ui/FSharp.Wasm.Ui.fsproj" />
    <!-- the operations on a document and the history (fsharp-wasm-core), and where a drag lands (fsharp-wasm-graphics; geometry only) -->
    <ProjectReference Include="../../lib/fsharp-wasm-core/FSharp.Wasm.Edit/FSharp.Wasm.Edit.fsproj" />
    <ProjectReference Include="../../lib/graphics/src/FSharp.Graphics.Interact/FSharp.Graphics.Interact.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Model.fs" />
    <Compile Include="Color.fs" />
    <Compile Include="Profile.fs" />
    <Compile Include="Markup.fs" />
    <Compile Include="Render.fs" />
    <Compile Include="Codec.fs" />
    <Compile Include="Lint.fs" />
    <Compile Include="Sample.fs" />
    <Compile Include="Dnd.fs" />
    <Compile Include="Projects.fs" />
    <Compile Include="Studio.fs" />
  </ItemGroup>
</Project>
