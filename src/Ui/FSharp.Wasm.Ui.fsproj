<Project Sdk="Microsoft.NET.Sdk">
  <!-- Typed CSS and HTML for the web and for email: values, selectors, rules and a renderer; a document tree that is pure data; an inliner;
       and the grid and components of Foundation for Emails (MIT) written as F#.  No dependencies: it runs under .NET and as WasmGC. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <RootNamespace>FSharp.Wasm.Ui</RootNamespace>
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);NU1900;NETSDK1188</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Basics.fs" />
    <Compile Include="Color.fs" />
    <Compile Include="Style.fs" />
    <Compile Include="Html.fs" />
    <Compile Include="Inline.fs" />
    <Compile Include="Ink.fs" />
  </ItemGroup>
</Project>
