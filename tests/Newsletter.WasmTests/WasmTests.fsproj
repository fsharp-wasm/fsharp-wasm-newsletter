<Project Sdk="Microsoft.NET.Sdk">
  <!-- The same suites as a WebAssembly GC module, compiled by fsharp-wasm: `bash build/test.sh` writes dist/WasmTests.wasm. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>WasmTests</AssemblyName>
    <LangVersion>preview</LangVersion>
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);NU1900;NETSDK1188</NoWarn>
    <FSHARP_WASM_CORE_DIR Condition="'$(FSHARP_WASM_CORE_DIR)' == ''">$(MSBuildThisFileDirectory)../../lib/fsharp-wasm-core</FSHARP_WASM_CORE_DIR>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Newsletter.Tests/Tests.fs" />
    <Compile Include="WasmTests.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Newsletter.Core/Newsletter.Core.fsproj" />
    <ProjectReference Include="../../lib/wasmecto/src/Wasmecto.fsproj" />
  </ItemGroup>
</Project>
