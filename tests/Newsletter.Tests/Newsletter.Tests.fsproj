<Project Sdk="Microsoft.NET.Sdk">
  <!-- The suites under .NET: `dotnet run -c Release` in this directory, after `source build/env.sh`. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);NU1900;NETSDK1188</NoWarn>
    <FSHARP_WASM_CORE_DIR Condition="'$(FSHARP_WASM_CORE_DIR)' == ''">$(MSBuildThisFileDirectory)../../lib/fsharp-wasm-core</FSHARP_WASM_CORE_DIR>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Tests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Newsletter.Core/Newsletter.Core.fsproj" />
    <ProjectReference Include="../../lib/wasmecto/src/Wasmecto.fsproj" />
  </ItemGroup>
</Project>
